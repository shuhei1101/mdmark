{
  "name": "mdmark",
  "private": true,
  "type": "module",
  "bin": {
    "mdmark": "dist/cli.js"
  },
  "scripts": {
    "test:unit": "vitest run --project 'unit*'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build": "node scripts/build.ts",
    "test:integration": "vitest run --project 'integration*'",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "storybook:render": "node scripts/storybook-render.ts",
    "storybook": "storybook dev --ci --no-open"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@highlightjs/cdn-assets": "11.12.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.64.0",
    "@storybook/server": "10.6.2",
    "@storybook/server-webpack5": "10.6.2",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@vitest/browser-playwright": "5.0.4",
    "eslint": "10.13.0",
    "eslint-plugin-compat": "7.0.2",
    "highlight.js": "11.12.0",
    "playwright": "1.64.0",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "diff": "8.0.4",
    "esbuild": "0.28.2",
    "lucide": "1.59.0",
    "markdown-it": "15.0.2",
    "sanitize-html": "2.18.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "webpack-dev-middleware": "^7.4.6"
  }
}
