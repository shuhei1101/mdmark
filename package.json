{
  "name": "mdmark",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "mdmark": "dist/cli.js"
  },
  "scripts": {
    "test:unit": "vitest run --project 'unit*'",
    "typecheck": "tsc --noEmit",
    "typecheck:vscode": "tsc --noEmit -p vscode",
    "lint": "biome check .",
    "lint:eslint": "node scripts/eslint.ts",
    "check": "npm run lint && npm run lint:eslint && npm run typecheck && npm run typecheck:vscode",
    "build": "node scripts/build.ts",
    "test:integration": "vitest run --project 'integration*'",
    "test": "npm run test:unit && npm run test:integration",
    "storybook:render": "node scripts/storybook-render.ts",
    "fixtures:mermaid": "node scripts/mermaid-fixtures.ts",
    "storybook": "storybook dev --ci --no-open"
  },
  "devDependencies": {
    "@babel/standalone": "8.1.1",
    "@biomejs/biome": "2.5.15",
    "@highlightjs/cdn-assets": "11.12.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "10.13.0",
    "eslint-plugin-compat": "7.0.2",
    "highlight.js": "11.12.0",
    "lucide-react": "1.69.0",
    "mermaid": "12.3.0",
    "msw": "3.0.4",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "storybook": "10.6.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite": "8.3.6",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "diff": "8.0.4",
    "esbuild": "0.28.2",
    "lucide": "1.59.0",
    "markdown-it": "15.0.3",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1"
  }
}
