{
  "$id": "common.schema.json",
  "$defs": {
    "collapse": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "line_range": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    },
    "column_ref": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "column"
      ],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
