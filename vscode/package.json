{
  "name": "mdmark-vscode",
  "displayName": "mdmark for VS Code",
  "description": "Markdown を mdmark で描いたプレビューを VS Code に出し、HTML への書き出しと PDF への印刷ができる",
  "version": "0.1.3",
  "publisher": "ShuheiNishikawa",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuhei1101/mdmark.git",
    "directory": "vscode"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mdmark"
  ],
  "engines": {
    "vscode": "^1.141.0",
    "node": ">=24"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:mdmark.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdmark.openPreviewToSide",
        "title": "プレビューを横に開く",
        "category": "mdmark",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdmark.openPreview",
        "title": "プレビューを開く",
        "category": "mdmark"
      },
      {
        "command": "mdmark.refreshPreview",
        "title": "プレビューをリロード",
        "category": "mdmark"
      },
      {
        "command": "mdmark.openConfig",
        "title": "設定ファイルを開く",
        "category": "mdmark"
      },
      {
        "command": "mdmark.openSettings",
        "title": "設定を開く",
        "category": "mdmark",
        "icon": "$(gear)"
      },
      {
        "command": "mdmark.exportHtml",
        "title": "HTML に書き出す",
        "category": "mdmark"
      },
      {
        "command": "mdmark.openInBrowser",
        "title": "ブラウザで開く",
        "category": "mdmark"
      },
      {
        "command": "mdmark.printToPdf",
        "title": "PDF に印刷",
        "category": "mdmark"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdmark.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "mdmark.openSettings",
          "when": "activeWebviewPanelId == 'mdmark.preview'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdmark.openPreviewToSide",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdmark.preview'"
        },
        {
          "command": "mdmark.openPreview",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdmark.preview'"
        },
        {
          "command": "mdmark.refreshPreview",
          "when": "mdmark.previewOpen"
        },
        {
          "command": "mdmark.openConfig"
        },
        {
          "command": "mdmark.openSettings"
        },
        {
          "command": "mdmark.exportHtml",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdmark.preview'"
        },
        {
          "command": "mdmark.openInBrowser",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdmark.preview'"
        },
        {
          "command": "mdmark.printToPdf",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'mdmark.preview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdmark.openPreviewToSide",
        "key": "shift+alt+d",
        "mac": "shift+alt+d",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "mdmark",
      "properties": {
        "mdmark.version": {
          "type": "string",
          "default": "latest",
          "pattern": "^(latest|v\\d+\\.\\d+\\.\\d+)$",
          "patternErrorMessage": "latest か v{X}.{Y}.{Z} の構造で記載してください",
          "scope": "resource",
          "description": "読み込む mdmark のバージョン。latest のときはプレビューを開くときとリロードしたときに GitHub のタグ一覧から最新の v{X}.{Y}.{Z} を選ぶ。バージョンを記載するとそのバージョンに固定する"
        },
        "mdmark.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "拡張機能が読み込む YAML のパス。空のときは Markdown のフォルダから上へ mdmark.config.yaml を探し、端末の設定と重ねる。記載したときは上へ探さず、このファイルと端末の設定だけを重ねる。相対パスは Markdown を含むワークスペースのフォルダから解決する"
        },
        "mdmark.preview.liveUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "true のときは Markdown を打つたびに再描画する。false のときは保存したときだけ再描画する"
        },
        "mdmark.preview.updateDelayMs": {
          "type": "integer",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "scope": "resource",
          "description": "最後に打ってから再描画するまでのミリ秒"
        },
        "mdmark.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "エディタをスクロールしたときに、プレビューを同じ箇所まで動かす"
        },
        "mdmark.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "プレビューをスクロールしたときに、エディタを同じ箇所まで動かす"
        },
        "mdmark.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "プレビューの配色。auto は VS Code のテーマの明暗に合わせ、light・dark はその配色に固定する"
        },
        "mdmark.colorTheme": {
          "type": "string",
          "enum": [
            "",
            "dev-swiss",
            "theme-paper",
            "theme-slate",
            "theme-contrast"
          ],
          "enumItemLabels": [
            "（設定ファイルに従う）",
            "dev-swiss",
            "theme-paper",
            "theme-slate",
            "theme-contrast"
          ],
          "default": "",
          "scope": "resource",
          "description": "プレビューと書き出す HTML の配色のテーマ。空のときは設定ファイルの colorTheme に従い、そこにも無ければ dev-swiss で描く。明暗は mdmark.preview.theme が決める"
        },
        "mdmark.export.outputDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "HTML を書き出すフォルダ。空のときは Markdown と同じフォルダ。相対パスは Markdown を含むワークスペースのフォルダから解決する"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out mdmark-$npm_package_version.vsix",
    "release:check": "node scripts/release-check.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/build.ts --tests && node tests/integration/run.ts"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@radix-ui/react-slot": "1.5.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "lucide-react": "1.69.0",
    "mocha": "12.0.3",
    "msw": "3.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "yaml": "2.9.1"
  }
}
