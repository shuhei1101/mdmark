## 2. 100 ms ごとに Date.now と performance.now の進みの差を 180 秒測り、20 ms 以上ずれた時刻を出す
$ node jumps.mjs 180
let pd = Date.now(), pp = performance.now(); const jumps = [];
const end = performance.now() + Number(process.argv[2]) * 1000;
const iv = setInterval(() => {
  const d = Date.now(), p = performance.now();
  const j = (d - pd) - (p - pp);
  if (Math.abs(j) >= 20) jumps.push({ at: new Date(d).toISOString(), jumpMs: Math.round(j) });
  pd = d; pp = p;
  if (p > end) { clearInterval(iv); console.log(JSON.stringify(jumps)); }
}, 100);
