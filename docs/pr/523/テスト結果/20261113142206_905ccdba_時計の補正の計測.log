# 端末: WSL2 6.6.87.2-microsoft-standard-WSL2、node v24.14.0

## 1. AbortSignal.timeout(3000) が中断するまでを Date.now と performance.now で測る（4 本並べて 28 回）
$ node drift.mjs
const d0 = Date.now(), p0 = performance.now();
let maxDiff = 0, early = [];
const iv = setInterval(() => {
  const diff = (Date.now() - d0) - (performance.now() - p0);
  if (Math.abs(diff) > Math.abs(maxDiff)) maxDiff = diff;
}, 50);
let n = 0;
function one() {
  const ds = Date.now(), ps = performance.now();
  const s = AbortSignal.timeout(3000);
  s.addEventListener("abort", () => {
    const de = Date.now() - ds, pe = performance.now() - ps;
    if (de < 2990 || pe < 2990) early.push({ de, pe });
    if (++n < 25) one(); else { clearInterval(iv); console.log(JSON.stringify({ n, maxDiff, early })); }
  });
}
for (let i = 0; i < 4; i++) one();
---
