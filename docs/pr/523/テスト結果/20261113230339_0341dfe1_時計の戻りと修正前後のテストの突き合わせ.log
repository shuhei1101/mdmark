$ repeat.sh old 20; repeat.sh new 20
#!/bin/bash
# 引数: old|new 回数。test_normal_when_tags_unreachable だけを test.only にして繰り返す（作業ツリーは最後に戻す）
set -u
W=/mnt/c/Users/shuhe/repo/mdmark/.claude/worktrees/fix-vscode-tags-timeout-early-abort
cd "$W"
if [ "$1" = old ]; then
  cp /tmp/pr523/old-preview-open.test.ts vscode/tests/integration/preview-open.test.ts
  cp /tmp/pr523/old-stub-server.ts vscode/tests/integration/stub-server.ts
fi
sed -i 's/  test("test_normal_when_tags_unreachable"/  test.only("test_normal_when_tags_unreachable"/' vscode/tests/integration/preview-open.test.ts
for i in $(seq "$2"); do
  echo "=== $1 $i 回目 開始 $(date -u +%H:%M:%S.%3N)"
  timeout 600 xvfb-run -a npm --prefix vscode run test:integration 2>&1 | command grep -E 'Validated version|✔ test_|^\s+[0-9]+\) |要求まで|/tags の要求|拡張機能のログ|passing|failing'
done
git checkout -- vscode/tests/integration/preview-open.test.ts vscode/tests/integration/stub-server.ts
git status -s
