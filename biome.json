{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!dev",
      "!docs",
      "!dist",
      "!vscode/dist",
      "!vscode/media",
      "!vscode/out",
      "!vscode/node_modules",
      "!vscode/.vscode-test",
      "!node_modules",
      "!package-lock.json",
      "!test-results",
      "!playwright-report",
      "!.vitest"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["src/index.css", "vscode/src/webview/preview.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
