{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!dev",
      "!docs",
      "!dist",
      "!migrations/*/legacy-marks.js",
      "!migrations/*/retired-diagrams.js",
      "!vscode/dist",
      "!vscode/media",
      "!.storybook/public",
      "!tests/fixtures/mermaid-svg",
      "!vscode/out",
      "!vscode/node_modules",
      "!vscode/.vscode-test",
      "!plugin/scripts",
      "!plugin/guide",
      "!node_modules",
      "!package-lock.json",
      "!.vitest"
    ]
  },
  "linter": {
    "domains": {
      "react": "none"
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["src/index.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
